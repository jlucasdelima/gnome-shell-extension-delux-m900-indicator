#!/usr/bin/env python3
"""Battery reader for the DELUX M900 Pro over its 2.4G receiver (1d57:fa60).

The receiver pushes input report 3 on its vendor interface about every two
seconds: `03 <model> <event> <b3> <b4>`. Event 0x40 carries the power state
in b3 (1 on battery, 2 fully charged, 3 charging) and the level in b4. See
docs/re/findings.md for the evidence.

  m900-hid watch     one JSON object per line, whenever something changes:
                     {"ok": true, "event": "power", "device": ...,
                      "state": "discharging", "level": 74}
                     {"ok": true, "event": "dpi", "stage": 3}       (1-8)
                     {"ok": true, "event": "polling", "index": 3}   (0-3)
                     {"ok": false, "error": <code>}
  m900-hid apply <profile-json> <hex>...
                     sends each feature report, waits for its ACK and then
                     saves the profile to PROFILE_PATH:
                     {"ok": true} or {"ok": false, "error": <code>}
  m900-hid save <profile-json>
                     saves the profile without sending anything, for changes
                     the mouse made itself (DPI button, rate shortcut)

The mouse cannot be read back (DELUX.exe never asks for a feature report),
so the saved profile is the only record of what was last applied. Model.js
builds every report; this helper only moves bytes.

Error codes: missing (no receiver), access-denied (no permission on the
hidraw node), asleep (receiver present, mouse silent for SILENCE_SECONDS),
timeout (no ACK), rejected (ACK with a non-zero status), invalid (bad
arguments), unsupported (apply with only the fa65 8K HS receiver, which
takes no feature reports).
"""

from __future__ import annotations

import errno
import fcntl
import json
import os
import select
import sys
import time
from pathlib import Path
from typing import Optional

HID_ID = "0003:00001D57:0000FA60"
# The 2.4G 8K HS receiver (1d57:fa65) sends the same input report 3, but its
# vendor interface has no feature reports (only a 63-byte report 4, in and
# out), so it is read-only here: watch uses it, apply refuses it.
HS_HID_ID = "0003:00001D57:0000FA65"
WATCH_IDS = (HID_ID, HS_HID_ID)
# Collection with UsagePage 0x0A (input report 3): Usage Page, Usage 0,
# Collection (Application), Report ID 3.
VENDOR_COLLECTION = bytes.fromhex("050a0900a1018503")
REPORT_ID = 0x03
EVENT_DPI = 0x10
EVENT_POLLING = 0x20
EVENT_POWER = 0x40
EVENT_ACK = 0x50
ACK_SECONDS = 1.0
FEATURE_REPORT_IDS = {0x04, 0x05, 0x06, 0x08, 0x0C}
PROFILE_PATH = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state") / "delux-m900" / "profile.json"
POWER_STATES = {2: "full", 3: "charging"}
# DELUX.exe marks the mouse disconnected after 6 s without a report.
SILENCE_SECONDS = 6.0
RETRY_SECONDS = 3.0


def find_device(root: Path = Path("/sys/class/hidraw"), ids: tuple = (HID_ID,)) -> Optional[str]:
    for node in sorted(root.glob("hidraw*")):
        try:
            uevent = (node / "device" / "uevent").read_text()
            descriptor = (node / "device" / "report_descriptor").read_bytes()
        except OSError:
            continue
        if any(f"HID_ID={i}" in uevent for i in ids) and VENDOR_COLLECTION in descriptor:
            return "/dev/" + node.name
    return None


def hidiocsfeature(length: int) -> int:
    # _IOC(_IOC_WRITE | _IOC_READ, 'H', 0x06, length)
    return (3 << 30) | (length << 16) | (ord("H") << 8) | 0x06


def decode(report: bytes) -> Optional[dict]:
    """Event from one input report, or None for reports the widget ignores."""
    if len(report) < 5 or report[0] != REPORT_ID:
        return None
    event, b3, b4 = report[2], report[3], report[4]
    if event == EVENT_POWER:
        state = POWER_STATES.get(b3, "discharging")
        if state == "full":
            b4 = 100
        elif not 1 <= b4 <= 100:
            return None
        return {"event": "power", "state": state, "level": b4}
    if event == EVENT_DPI and 1 <= b3 <= 8:
        return {"event": "dpi", "stage": b3}
    if event == EVENT_POLLING and 1 <= (b3 & 0x0F) <= 4:
        return {"event": "polling", "index": (b3 & 0x0F) - 1}
    return None


def ack_for(report: bytes) -> Optional[tuple]:
    """(report id, status) when the input report is a command ACK."""
    if len(report) < 5 or report[0] != REPORT_ID or report[2] != EVENT_ACK:
        return None
    return report[4], report[3]


def parse_packet(text: str) -> bytes:
    packet = bytes.fromhex(text)
    if len(packet) < 3 or packet[0] not in FEATURE_REPORT_IDS or packet[1] != len(packet):
        raise ValueError(text)
    return packet


def send_packets(device: str, packets: list) -> Optional[str]:
    """Sends each packet and waits for its ACK; returns an error code or None."""
    fd = os.open(device, os.O_RDWR | os.O_NONBLOCK)
    try:
        for packet in packets:
            while select.select([fd], [], [], 0)[0]:  # drop stale reports
                os.read(fd, 64)
            fcntl.ioctl(fd, hidiocsfeature(len(packet)), bytearray(packet))
            deadline = time.monotonic() + ACK_SECONDS
            while True:
                left = deadline - time.monotonic()
                if left <= 0:
                    return "timeout"
                if not select.select([fd], [], [], left)[0]:
                    continue
                ack = ack_for(os.read(fd, 64))
                if ack is None or ack[0] != packet[0]:
                    continue
                if ack[1] != 0:
                    return "rejected"
                break
    finally:
        os.close(fd)
    return None


def save_profile(profile: dict, path: Path = PROFILE_PATH) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_suffix(".tmp")
    temp.write_text(json.dumps(profile, indent=2) + "\n")
    temp.replace(path)


def apply(args: list) -> dict:
    try:
        profile = json.loads(args[0])
        packets = [parse_packet(text) for text in args[1:]]
    except (IndexError, ValueError):
        return {"ok": False, "error": "invalid"}
    if not isinstance(profile, dict) or not packets:
        return {"ok": False, "error": "invalid"}
    device = find_device()
    if device is None:
        if find_device(ids=(HS_HID_ID,)) is not None:
            return {"ok": False, "error": "unsupported"}
        return {"ok": False, "error": "missing"}
    try:
        error = send_packets(device, packets)
    except PermissionError:
        return {"ok": False, "error": "access-denied"}
    except OSError:
        return {"ok": False, "error": "missing"}
    if error is not None:
        return {"ok": False, "error": error}
    save_profile(profile)
    return {"ok": True}


def emit(message: dict, last: list) -> None:
    if last and last[0] == message:
        return
    last[:] = [message]
    print(json.dumps(message), flush=True)


def watch_device(device: str, last: list) -> None:
    """Reads until the node goes away; returns so the caller searches again."""
    fd = os.open(device, os.O_RDONLY | os.O_NONBLOCK)
    try:
        heard = time.monotonic()
        while True:
            ready, _, _ = select.select([fd], [], [], 1.0)
            if not ready:
                if time.monotonic() - heard >= SILENCE_SECONDS:
                    emit({"ok": False, "error": "asleep"}, last)
                continue
            try:
                report = os.read(fd, 64)
            except BlockingIOError:
                continue
            if not report:
                return
            heard = time.monotonic()
            message = decode(report)
            if message is not None:
                emit({"ok": True, "device": device, **message}, last)
    except OSError as error:
        if error.errno not in (errno.ENODEV, errno.EIO, errno.ENOENT):
            raise
    finally:
        os.close(fd)


def watch() -> int:
    last: list = []
    while True:
        device = find_device(ids=WATCH_IDS)
        if device is None:
            emit({"ok": False, "error": "missing"}, last)
        else:
            try:
                watch_device(device, last)
                continue
            except PermissionError:
                emit({"ok": False, "error": "access-denied"}, last)
            except FileNotFoundError:
                emit({"ok": False, "error": "missing"}, last)
        time.sleep(RETRY_SECONDS)


def main(argv: list) -> int:
    if argv[1:] == ["watch"]:
        try:
            return watch()
        except KeyboardInterrupt:
            return 0
    if len(argv) == 3 and argv[1] == "save":
        try:
            profile = json.loads(argv[2])
        except ValueError:
            profile = None
        if not isinstance(profile, dict):
            print(json.dumps({"ok": False, "error": "invalid"}), flush=True)
            return 1
        save_profile(profile)
        print(json.dumps({"ok": True}), flush=True)
        return 0
    if len(argv) >= 2 and argv[1] == "apply":
        result = apply(argv[2:])
        print(json.dumps(result), flush=True)
        return 0 if result["ok"] else 1
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
